clc;
clear;
clf;

N = 30;
n = 0:N-1;

// Sequence 1
f1 = 0.05;
A1 = 2;
x1 = A1 * sin(2 * %pi * f1 * n);

// Sequence 2
a = 0.1;
A2 = 3;
x2 = A2 * exp(-a * n);

// Operations
x_add = x1 + x2;
x_mul = x1 .* x2;

// Plot
subplot(4,1,1);
plot2d3(n,x1);
title("Sequence 1");

subplot(4,1,2);
plot2d3(n,x2);
title("Sequence 2");

subplot(4,1,3);
plot2d3(n,x_add);
title("Addition");

subplot(4,1,4);
plot2d3(n,x_mul);
title("Multiplication");
