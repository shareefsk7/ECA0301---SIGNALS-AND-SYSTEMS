clc;
clear;

x = [1 2 3 4];
N = length(x);
X = zeros(1,N);

for k = 1:N
    s = 0;
    for n = 1:N
        s = s + x(n)*exp(-%i*2*%pi*(k-1)*(n-1)/N);
    end
    X(k) = s;
end

disp("DFT of the sequence:");
disp(X);

clf;
subplot(2,1,1);
plot2d3(0:N-1,x);
xtitle("Input Sequence");

subplot(2,1,2);
plot(0:N-1,abs(X));
xtitle("Magnitude Spectrum");
