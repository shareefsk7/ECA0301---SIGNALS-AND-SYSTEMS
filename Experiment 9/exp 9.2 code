clc;
clear;

x = [1 2 3 4];
h = [1 1 1 1];

N = length(x);

X = fft(x,-1);
H = fft(h,-1);

Y = X .* H;
y = real(fft(Y,1));

disp("Circular Convolution:");
disp(y);

clf;
subplot(3,1,1);
plot2d3(0:N-1,x);
xtitle("Sequence x[n]");

subplot(3,1,2);
plot2d3(0:N-1,h);
xtitle("Sequence h[n]");

subplot(3,1,3);
plot2d3(0:N-1,y);
xtitle("Circular Convolution Output");
