clc;
clear;
clf;

N = 20;
n = 0:N-1;
x = ones(1,N);

y_causal = zeros(1,N);
y_noncausal = zeros(1,N);

// Causal
for k = 1:N
    if k > 1 then
        y_causal(k) = x(k) + 0.5*x(k-1);
    else
        y_causal(k) = x(k);
    end
end

// Non-Causal
for k = 1:N
    if k < N then
        y_noncausal(k) = 0.5*x(k) + 0.5*x(k+1);
    else
        y_noncausal(k) = 0.5*x(k);
    end
end

subplot(3,1,1);
plot2d3(n,x);
title("Input");

subplot(3,1,2);
plot2d3(n,y_causal);
title("Causal System");

subplot(3,1,3);
plot2d3(n,y_noncausal);
title("Non-Causal System");
