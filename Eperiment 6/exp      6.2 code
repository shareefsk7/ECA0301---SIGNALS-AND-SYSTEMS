clc;
clear;

x = [1 2 3 4];
h = [1 1 1];

y = convol(x,h);

n1 = 0:length(x)-1;
n2 = 0:length(h)-1;
ny = 0:length(y)-1;

clf;
subplot(3,1,1);
plot2d3(n1,x);
xtitle("Input Sequence x[n]");

subplot(3,1,2);
plot2d3(n2,h);
xtitle("Impulse Response h[n]");

subplot(3,1,3);
plot2d3(ny,y);
xtitle("Convolution Output y[n]");
